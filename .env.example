# Browser-safe project credentials only. NEVER put a service-role or Google secret here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Local dev automatically offers demo mode when both credentials are absent.
# Production needs real credentials, or an explicit demo-only build:
VITE_DEMO_MODE=false
# Public half of the Web Push VAPID key pair (safe to expose) -- generate with
# `npx web-push generate-vapid-keys`. The private half is a Supabase Edge Function secret only.
VITE_VAPID_PUBLIC_KEY=
