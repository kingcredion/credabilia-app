{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.credabilia.com"
        }
      ],
      "destination": "https://credabilia.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/img/item/:id",
      "destination": "/api/email-image?id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
