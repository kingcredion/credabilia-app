# Capacitor native build output (android/ and ios/ project files themselves are committed;
# only the generated/machine-specific build artifacts are excluded). The synced web build is
# regenerated by `npx cap sync` from dist/ before every native build -- same reasoning as
# gitignoring dist/ itself, just copied one level deeper into each native project.
android/app/src/main/assets/public/
ios/App/App/public/
android/local.properties
android/.gradle/
android/app/build/
android/build/
android/captures/
android/.externalNativeBuild/
android/.cxx/
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
*.xcuserstate
